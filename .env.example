# Actual Budget connection
# Local pnpm dev: use localhost
# Docker Compose (full stack): use http://actual-server:5006
# Docker GHCR + existing Actual on host: try http://host.docker.internal:5006
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_SERVER_PASSWORD=your-server-password
ACTUAL_SYNC_ID=your-sync-id
# Leave empty unless end-to-end encryption is enabled on the budget
ACTUAL_E2E_PASSWORD=

# Optional app auth — leave unset for trusted LAN (default).
# When APP_AUTH_PASSWORD is set, pages and API require HTTP Basic
# (user defaults to "reports") or Authorization: Bearer <password>.
APP_AUTH_PASSWORD=
APP_AUTH_USER=reports

# App paths — local defaults; Docker Compose overrides to /data/...
ACTUAL_DATA_DIR=.data/actual-cache
SETTINGS_PATH=.data/settings.json
SYNC_INTERVAL_MS=300000

PORT=3000
